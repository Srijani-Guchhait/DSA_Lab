#include <stdio.h>

int main()
{
    int a[100], n, i, pos, num;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    // Insertion
    printf("Enter position for insertion: ");
    scanf("%d", &pos);

    printf("Enter number to insert: ");
    scanf("%d", &num);

    for(i = n; i >= pos; i--)
        a[i] = a[i - 1];

    a[pos - 1] = num;
    n++;

    printf("After insertion:\n");
    for(i = 0; i < n; i++)
        printf("%d ", a[i]);

    // Deletion
    printf("\nEnter position for deletion: ");
    scanf("%d", &pos);

    for(i = pos - 1; i < n - 1; i++)
        a[i] = a[i + 1];

    n--;

    printf("After deletion:\n");
    for(i = 0; i < n; i++)
        printf("%d ", a[i]);

    return 0;
}
